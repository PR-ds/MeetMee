# MeetMee Frontend Environment Variables Template
VITE_APP_NAME="MeetMee"
VITE_API_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000"

# Supabase Cloud Database Configuration
# Fill these in with your Supabase Project settings (Settings -> API)
