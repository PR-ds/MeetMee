# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Cache (Supabase PostgreSQL Recommended)
# Direct connection:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler connection:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0
USE_SQLITE=false

# Autonomous Bot Engine (Recall.ai)
RECALL_AI_API_KEY=your_recall_ai_api_key_here
RECALL_AI_BASE_URL=https://api.recall.ai/api/v1
BOT_NAME="MeetMee AI Assistant"

# Real-Time Streaming ASR (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM Orchestration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Multilingual Podcast TTS (ElevenLabs API)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_HOST_A_VOICE_ID=21m00Tcm4TlvDq8ikWAM # Rachel
ELEVENLABS_HOST_B_VOICE_ID=pNInz6obpgDQGcFmaJgB # Adam

# Email Delivery (Resend API)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL="MeetMee <notes@meetmee.ai>"

# Visual Comics (Fal.ai / Replicate FLUX.1)
FAL_KEY=your_fal_key_here
